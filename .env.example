POSTGRES_USER=docketiq
POSTGRES_PASSWORD=docketiq
POSTGRES_DB=docketiq

# The postgres host only resolves on the Compose network, and the container
# publishes 5433 to avoid a local Postgres already holding 5432. Running the
# API from the host needs both changes:
# DATABASE_URL=postgres://docketiq:docketiq@localhost:5433/docketiq?sslmode=disable
DATABASE_URL=postgres://docketiq:docketiq@postgres:5432/docketiq?sslmode=disable

API_ADDR=:8080
APP_TIMEZONE=America/New_York
POLL_INTERVAL=10m
POLL_CONCURRENCY=5
CACHE_TTL=5m
SOURCES_FILE=sources.json
MOCK_FEEDS=true

API_URL=http://api:8080
